# Copy to .env and fill in. Never commit .env.

# Needed for Claude models (the default). Not needed with --model mock.
ANTHROPIC_API_KEY=

# Redis for the queues and the run state. docker compose sets this for its services.
REDIS_URL=redis://127.0.0.1:6379

# Ollama server for --model ollama:<name> (default http://127.0.0.1:11434).
OLLAMA_HOST=http://127.0.0.1:11434
